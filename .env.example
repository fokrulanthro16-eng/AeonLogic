# ═══════════════════════════════════════════════════════════════════════════════
# AeonLogic — Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to VCS.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                     # development | staging | production
APP_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true                         # set false in production

# ── Model routing (Qwen / DashScope OpenAI-compatible API) ───────────────────
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tier assignment (do not change unless you add a new model)
MODEL_FAST=qwen-turbo          # low-risk, latency-sensitive tasks
MODEL_STRONG=qwen-plus         # complex, high-risk, security-sensitive tasks

# Per-model token budget caps (prevents runaway inference costs)
MODEL_FAST_MAX_TOKENS=4096
MODEL_STRONG_MAX_TOKENS=8192

# Request timeouts in seconds
LLM_REQUEST_TIMEOUT=60

# ── Neo4j Knowledge Graph ──────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=aeonlogic           # leave blank to use the default database
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ── ChromaDB Vector Store ──────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=aeonlogic_memories
# Leave blank to use the embedded (in-process) mode instead of HTTP client
CHROMA_SERVER_MODE=http            # http | embedded

# ── LangGraph / LangSmith tracing (optional) ─────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=aeonlogic

# ── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aeonlogic

# ── Prometheus metrics ─────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090

# ── Security & execution sandbox ──────────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=30
MAX_RECURSION_DEPTH=10             # hard cap on recursive agent cycles

# ── Checkpointing ─────────────────────────────────────────────────────────────
CHECKPOINT_BACKEND=memory          # memory | sqlite | postgres
CHECKPOINT_DB_URI=sqlite:///data/checkpoints.db
