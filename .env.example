# ═══════════════════════════════════════════════════════════════════════════════
# AeonLogic — Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to VCS.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                     # development | staging | production
LOG_LEVEL=WARNING                       # DEBUG | INFO | WARNING | ERROR

# ── AeonLogic runtime mode (Phase 6A+) ───────────────────────────────────────
# auto  — use real Qwen if QWEN_API_KEY is set, otherwise mock (default)
# real  — explicitly require real Qwen; shows FALLBACK_MODE if key absent or call fails
# mock  — always use the deterministic mock client regardless of key
AEONLOGIC_MODE=auto

# ── Qwen API ──────────────────────────────────────────────────────────────────
# Leave QWEN_API_KEY empty or unset to run in MOCK_MODEL_MODE (no API calls).
# Set AEONLOGIC_MODE=real and a valid key to enable REAL_MODEL_MODE.
QWEN_API_KEY=                           # sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=                             # optional model override (e.g. qwen-max); empty = use budget default

# ── Model names (overridable) ──────────────────────────────────────────────────
QWEN_FAST_MODEL=qwen-turbo             # low-risk, latency-sensitive tasks
QWEN_DEEP_MODEL=qwen-plus              # high-risk, security-sensitive tasks

# Per-model token budget caps (prevents runaway inference costs)
MODEL_FAST_MAX_TOKENS=4096
MODEL_STRONG_MAX_TOKENS=8192

# Request timeouts in seconds
LLM_REQUEST_TIMEOUT=60

# ── Neo4j Knowledge Graph ──────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=aeonlogic           # leave blank to use the default database
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ── ChromaDB Vector Store ──────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=aeonlogic_memories
# Leave blank to use the embedded (in-process) mode instead of HTTP client
CHROMA_SERVER_MODE=http            # http | embedded

# ── LangGraph / LangSmith tracing (optional) ─────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=aeonlogic

# ── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aeonlogic

# ── Prometheus metrics ─────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090

# ── Security & execution sandbox ──────────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=30
MAX_RECURSION_DEPTH=10             # hard cap on recursive agent cycles

# ── Checkpointing ─────────────────────────────────────────────────────────────
CHECKPOINT_BACKEND=memory          # memory | sqlite | postgres
CHECKPOINT_DB_URI=sqlite:///data/checkpoints.db
