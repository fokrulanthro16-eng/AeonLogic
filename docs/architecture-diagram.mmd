flowchart TD
    classDef usr    fill:#050c18,stroke:#00ccff,color:#c0e8ff,stroke-width:2px
    classDef front  fill:#071828,stroke:#00ccff,color:#b8d8f0,stroke-width:1px
    classDef eng    fill:#060f1c,stroke:#4090b8,color:#9ac0d8,stroke-width:1px
    classDef qwen   fill:#071a10,stroke:#00ee88,color:#90e0a8,stroke-width:1px
